<% user_name = @assignment.anonymize_students? ? I18n.t(:anonymous_user, "Anonymous User") : @submission.user.name %>

<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= before_label @assignment.title %> <%= user_name %></title>
</head>
<body>
<h1><%= before_label @assignment.title %> <%= user_name %></h1>
<div style="width: 600px; margin: 20px auto; border: 1px solid #888; padding: 20px;">
  <%= Sanitize.clean(@submission.body || "", CanvasSanitize::SANITIZE) %>
</div>
</body>
</html>
