<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="Refresh" content="0; url=<%= @submission.url %>">
  <title><%= before_label @assignment.title %> <%= @submission.user.name %></title>
</head>
<body>
<h1><%= before_label @assignment.title %> <%= @submission.user.name %></h1>
<%=
  mt :redirect_message, <<~MD, url: @submission.url
    This submission was a url, we're taking you to the url link now.
      [Click Here to go to the submission](%{url})
  MD
%>%
</body>
</html>
