<% provide :page_title, t("lti.token.page_title", "Generate LTI Advantage Access Token") %>

<div class="ic-Layout-contentMain" role="main">
  <h1><%= t("lti.token.heading", "Generate LTI Advantage Access Token") %></h1>
  <p><%= t("lti.token.description",
           "Enter the Tool ID and your authenticator app OTP code to generate " \
           "a short-lived LTI 1.3 access token for the specified tool.") %></p>

  <% if @error %>
    <div class="ic-flash-error">
      <div class="ic-flash__icon" aria-hidden="true"><i class="icon-warning"></i></div>
      <%= @error %>
    </div>
  <% end %>

  <% if @token_data %>
    <div class="ic-flash-success">
      <div class="ic-flash__icon" aria-hidden="true"><i class="icon-check"></i></div>
      <%= t("lti.token.success",
            "Token generated successfully. Copy it now - it expires in %{expires_in} seconds.",
            expires_in: @token_data["expires_in"]) %>
    </div>
    <div style="margin: 12px 0;">
      <label for="lti_access_token"><strong><%= t("lti.token.access_token_label", "Access Token") %></strong></label>
      <textarea id="lti_access_token" readonly rows="6" style="width: 100%; font-family: monospace; font-size: 12px;"><%= @token_data["access_token"] %></textarea>
    </div>
  <% end %>

  <%= form_tag(create_lti_token_site_admin_path, method: :post) do %>
    <div class="control-group">
      <label class="control-label" for="tool_id">
        <%= t("lti.token.tool_id_label", "Tool ID") %>
      </label>
      <div class="controls">
        <input type="text"
               id="tool_id"
               name="tool_id"
               value="<%= params[:tool_id] %>"
               placeholder="<%= t("lti.token.tool_id_placeholder", "e.g. 10000000000042") %>"
               style="width: 300px;" />
      </div>
    </div>

    <div class="control-group">
      <label class="control-label" for="verification_code">
        <%= t("lti.token.otp_label", "OTP Code") %>
      </label>
      <div class="controls">
        <input type="text"
               id="verification_code"
               name="verification_code"
               autocomplete="off"
               inputmode="numeric"
               placeholder="<%= t("lti.token.otp_placeholder", "6-digit code from authenticator app") %>"
               style="width: 300px;" />
      </div>
    </div>

    <div class="control-group">
      <div class="controls">
        <button type="submit" class="btn btn-primary">
          <%= t("lti.token.submit", "Generate Token") %>
        </button>
      </div>
    </div>
  <% end %>
</div>
