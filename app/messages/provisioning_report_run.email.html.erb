<% define_content :link do %>
  <%= account_reports_url(asset.account) %>
<% end %>

<% define_content :subject do %>
  <%= t(:subject, "Provisioning Report Started") %>
<% end %>

<% define_content :footer_link do %>
  <a href="<%= content(:link) %>">
    <%= t :link_message, "View account reports" %>
  </a>
<% end %>

<p><strong><%= t :subject, "Provisioning Report Started" %></strong></p>

<p><%= t :body,
         "The provisioning report for %{account} was started by %{user} at %{time}.",
         account: asset.account.name,
         user: asset.user.name,
         time: datetime_string(asset.start_at) %></p>
