<% define_content :link do %>
  <%= polymorphic_url([asset.context, asset]) %>
<% end %>

<% define_content :subject do %>
  <%= t "Submissions Posted: %{title}, %{course}", title: asset.title, course: asset.context.name %>
<% end %>

<%
  body_text = if @data.graded_only
                if @data.section_names.present?
                  t("Grade changes and comments have been released for everyone graded in sections: %{section_names}.", section_names: @data.section_names.to_sentence)
                else
                  t("Grade changes and comments have been released for everyone graded.")
                end
              elsif @data.section_names.present?
                t("Grade changes and comments have been released for everyone in sections: %{section_names}.", section_names: @data.section_names.to_sentence)
              else
                t("Grade changes and comments have been released for everyone.")
              end
%>

<%=
  t <<~TEXT, body_text:, url: content(:link)
        %{body_text}
    
    You can view the assignment here:
    %{url}
  TEXT
%>
