<%= content[:page_title] %>
==============
<% content[:event_payloads].each do |payload| %>
<h2 id="<%= payload.fetch("name") %>"><%= payload.fetch("name") %></h2>

**Definition:** <%= payload.fetch("definition") %>

<%   if payload.fetch("trigger", nil).present? %>
**Trigger:** <%= payload.fetch("trigger") %>
<%   end %>

<%   unless payload.fetch("schema").empty? %>
### Event Body Schema

| Field | Description |
|-|-|
<%     payload.fetch("schema").each do |event, descriptions| %>
<%       descriptions.each do |field, description| %>
| **<%= event %>.<%= field %>** | <%= description.gsub("\n", " - ") %> |
<%       end %>
<%     end %>
<%   end %>

<%   payload.fetch("examples", []).each do |example| %>
<%     if example.fetch("description", nil).present? %>
**Description:** <%= example.fetch("description") %>
<%     end %>
### Payload Example:

```json
<%= JSON.pretty_generate(example.fetch("payload")) %>
```

<%   end %>
<% end %>
