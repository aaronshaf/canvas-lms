{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx_a11y", "import", "promise", "typescript"],
  "jsPlugins": [
    "./config/canvas-copyright.js",
    "./config/oxlint-plugins/canvas-xss.js",
    "./config/canvas-sanitize-url.js",
    "./config/canvas-no-env-write.js",
    "./config/canvas-no-env-read.js",
    "./config/canvas-postmessage-origin-check.js"
  ],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "**/doc/**",
    "**/es/**",
    "Jenkinsfile.js",
    "**/ui/shared/jquery/**",
    "**/*.config.*",
    "**/jest/**",
    "ui/shared/graphql/codegen/**",
    "ui/shared/bundles/extensions.ts",
    "**/ui/ext/custom_moment_locales/**",
    "**/node_modules/**",
    "**/*.d.ts"
  ],
  "rules": {
    "no-constant-binary-expression": "warn",
    "no-dupe-class-members": "warn",
    "no-import-assign": "warn",
    "no-loss-of-precision": "warn",
    "no-prototype-builtins": "off",
    "no-unexpected-multiline": "warn",
    "no-unsafe-optional-chaining": "warn",
    "no-unused-expressions": "off",
    "no-useless-escape": "warn",
    "no-unused-vars": "off",
    "no-unused-private-class-members": "warn",
    "prefer-const": "warn",
    "no-redeclare": "warn",
    "no-global-assign": "warn",
    "typescript/ban-ts-comment": "warn",
    "typescript/no-unused-vars": [
      "warn",
      {
        "args": "all",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "typescript/no-this-alias": "off",
    "typescript/no-explicit-any": "off",
    "typescript/no-unused-expressions": "warn",
    "typescript/no-empty-object-type": "warn",
    "typescript/no-unsafe-function-type": "warn",
    "typescript/no-require-imports": "off",
    "typescript/no-wrapper-object-types": "warn",
    "typescript/no-non-null-asserted-optional-chain": "warn",
    "react/jsx-key": "warn",
    "react/no-string-refs": "warn",
    "react/no-find-dom-node": "warn",
    "react/jsx-no-target-blank": "warn",
    "react/no-unknown-property": "warn",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "jsx_a11y/role-has-required-aria-props": "warn",
    "jsx_a11y/no-autofocus": "warn",
    "import/no-dynamic-require": "warn",
    "import/no-nodejs-modules": "warn",
    "promise/always-return": "off",
    "promise/catch-or-return": "off"
  },
  "overrides": [
    {
      "files": ["ui/**/*.{js,mjs,ts,jsx,tsx}"],
      "rules": {
        "canvas-copyright/notice": "error",
        "canvas-xss/no-unsafe-html": "error",
        "canvas-sanitize-url/at-href": "error",
        "canvas-sanitize-url/imperative": "error",
        "canvas-no-env-write/no-env-write": "warn",
        "canvas-postmessage-origin-check/require-origin-check": "warn"
      }
    },
    {
      "files": [
        "gems/plugins/*/app/jsx/**/*.{js,mjs,ts,jsx,tsx}",
        "gems/plugins/*/public/javascripts/**/*.{js,mjs,ts,jsx,tsx}"
      ],
      "rules": {
        "canvas-xss/no-unsafe-html": "error"
      }
    },
    {
      "files": ["packages/**/*.{js,mjs,ts,jsx,tsx}"],
      "rules": {
        "canvas-no-env-read/no-env-read": "error"
      }
    },
    {
      "files": [
        "ui/shared/test-utils/**",
        "ui/shared/stub-env/**",
        "ui/shared/files/mockFilesENV.js",
        "**/__tests__/**",
        "**/*.{test,spec}.{js,ts,jsx,tsx}"
      ],
      "rules": {
        "canvas-xss/no-unsafe-html": "off",
        "canvas-no-env-write/no-env-write": "off",
        "canvas-no-env-read/no-env-read": "off"
      }
    },
    {
      "files": [
        "**/*.{test,spec}.{js,ts,tsx,jsx}",
        "**/__tests__/**",
        "**/__mocks__/**",
        "jest/**"
      ],
      "plugins": ["jest"],
      "rules": {
        "jest/no-disabled-tests": "warn",
        "jest/no-focused-tests": "error",
        "jest/valid-expect": "error"
      }
    },
    {
      "files": ["packages/canvas-rce/browser/**/*.{ts,tsx}"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
