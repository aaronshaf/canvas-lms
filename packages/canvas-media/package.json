{
  "name": "@instructure/canvas-media",
  "version": "5.1.0",
  "description": "A component that will handle upload/record and displaying of media",
  "author": "Instructure, Inc.",
  "main": "es/index.js",
  "module": "es/index.js",
  "sideEffects": false,
  "scripts": {
    "i18n:extract": "format-message extract \"es*/**/*.js*\" -g underscored_crc32 -o locales/en.json",
    "installTranslations": "scripts/installTranslations.js",
    "commitTranslations": "scripts/commitTranslations.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "vitest --inspect-brk",
    "build": "yarn installTranslations && yarn run build:es",
    "build:es": "scripts/build-es.js",
    "build:canvas": "yarn run build",
    "build:watch": "yarn run clean:es && tsc --watch",
    "clean": "rm -rf lib && yarn run clean:es && rm -rf coverage",
    "clean:es": "rm -rf es",
    "prepublishOnly": "yarn build && yarn test",
    "publishToNpm": "scripts/publish_to_npm.sh",
    "fmt:check": "biome check",
    "fmt:fix": "biome check --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instructure/canvas-lms.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/instructure/canvas-lms/issues"
  },
  "homepage": "https://github.com/instructure/canvas-lms#readme",
  "dependencies": {
    "@instructure/k5uploader": "*",
    "@instructure/studio-capture": "12.2.2",
    "@instructure/studio-player": "1.10.1",
    "@instructure/ui-a11y-content": "11.7.4-SECURITY.3",
    "@instructure/ui-alerts": "11.7.4-SECURITY.3",
    "@instructure/ui-billboard": "11.7.4-SECURITY.3",
    "@instructure/ui-buttons": "11.7.4-SECURITY.3",
    "@instructure/ui-checkbox": "11.7.4-SECURITY.3",
    "@instructure/ui-file-drop": "11.7.4-SECURITY.3",
    "@instructure/ui-flex": "11.7.4-SECURITY.3",
    "@instructure/ui-heading": "11.7.4-SECURITY.3",
    "@instructure/ui-icons": "11.7.4-SECURITY.3",
    "@instructure/ui-modal": "11.7.4-SECURITY.3",
    "@instructure/ui-progress": "11.7.4-SECURITY.3",
    "@instructure/ui-react-utils": "11.7.4-SECURITY.3",
    "@instructure/ui-select": "11.7.4-SECURITY.3",
    "@instructure/ui-spinner": "11.7.4-SECURITY.3",
    "@instructure/ui-tabs": "11.7.4-SECURITY.3",
    "@instructure/ui-text": "11.7.4-SECURITY.3",
    "@instructure/ui-text-input": "11.7.4-SECURITY.3",
    "@instructure/ui-tooltip": "11.7.4-SECURITY.3",
    "@instructure/ui-utils": "11.7.4-SECURITY.3",
    "@instructure/ui-view": "11.7.4-SECURITY.3",
    "es-toolkit": "^1.42.0",
    "format-message": "^6",
    "format-message-generate-id": "^6",
    "prop-types": "^15",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^13",
    "@testing-library/user-event": "^14",
    "@types/react": "*",
    "@types/react-dom": "*",
    "jsdom": "*",
    "vitest": "*"
  }
}
